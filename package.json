  "private": true,
  "description": "A local, searchable copy of the Pathfinder 2e rules and a Claude Code oracle that answers questions from it",
  "scripts": {
    "scrape": "npx ts-node -T scraper.ts",
    "mcp": "npx ts-node -T mcp.ts",
